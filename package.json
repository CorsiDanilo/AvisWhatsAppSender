{
  "name": "aviswhatsappsender",
  "version": "1.3.0",
  "description": "Applicazione desktop AVIS per inviare messaggi personalizzati tramite WhatsApp Web.",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "node --test",
    "build:gui": "npm --prefix gui run build",
    "lint:gui": "npm --prefix gui run lint",
    "prestart": "npm run build:gui",
    "start": "electron electron/main.cjs",
    "prebuild:win": "node scripts/make-icon.js gui/src/assets/avis-logo.png && node scripts/copy-browser.js",
    "build:win": "npm run build:gui && electron-builder --win nsis"
  },
  "build": {
    "appId": "it.avis.whatsappsender",
    "productName": "AVIS WhatsApp Sender",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "CorsiDanilo",
      "repo": "AvisWhatsAppSender"
    },
    "files": [
      "electron/**/*",
      "sender/**/*",
      "gui/dist/**/*",
      "build/icon.ico",
      "build/icon-notification.ico",
      
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": ".",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "**/node_modules/puppeteer-core/**",
      "**/node_modules/puppeteer/**",
      "**/node_modules/whatsapp-web.js/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AVIS WhatsApp Sender",
      "artifactName": "AVIS-WhatsApp-Sender-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CorsiDanilo/AvisWhatsAppSender.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/CorsiDanilo/AvisWhatsAppSender/issues"
  },
  "homepage": "https://github.com/CorsiDanilo/AvisWhatsAppSender#readme",
  "dependencies": {
    "csv-parser": "3.2.1",
    "electron-updater": "6.8.9",
    "qrcode": "1.5.4",
    "qrcode-terminal": "0.12.0",
    "whatsapp-web.js": "https://github.com/wwebjs/whatsapp-web.js/archive/064a3d5.tar.gz",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "jimp": "1.6.1",
    "png-to-ico": "3.0.2"
  }
}

